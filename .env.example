# Copy to .env (which is git-ignored) and change the password.
# Local development values only. Never reuse these anywhere real.

POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=hookrelay
POSTGRES_PORT=5432

REDIS_PORT=6379
KAFKA_PORT=9092

# Application-side connection settings (used from Phase 1 onward)
DATABASE_URL=postgres://hookrelay:change_me_locally@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092